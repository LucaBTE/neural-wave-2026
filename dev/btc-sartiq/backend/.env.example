FAL_API_KEY=your_fal_key_here
# Alternatively set FAL_KEY
# Optional: localhost frontend origin is enabled by default.

# Default: original context, fused analysis, one normal edit, diagnostic-only matte.
# Generated products are checked by Moondream (768px preview, <=30s timeout).
# Only a detected duplicate adds one corrective edit and one mandatory recheck.
FAL_PIPELINE_PROFILE=faithful
# Same model family as the official baseline, with selected-product context and 2K output.
FAL_IMAGE_MODEL=google/nano-banana-2.1/edit
FAL_IMAGE_RESOLUTION=2K
# Explicit alternatives for manual comparisons only:
# FAL_IMAGE_MODEL=fal-ai/nano-banana-pro/edit
# FAL_PIPELINE_PROFILE=staged  # old preprocessing + separate description + pressing
# To evaluate the Flash variant: FAL_IMAGE_MODEL=fal-ai/nano-banana-2/edit

# Staged profile only: color-correction strength (default: 1.05; allowed: 0.5..1.5).
# COLOR_CORRECTION_STRENGTH=1.05

# Faithful: visual analysis is fused into the required classification call.
# Staged profile: separate visual analysis. Moondream uses reasoning disabled.
# FAL_ANALYSIS_MODEL=fal-ai/moondream3-preview/query
# FAL_ANALYSIS_TIMEOUT=90
# FAL_ANALYSIS_MAX_SIDE=1280
# Classification uses Moondream Query; localization uses native Moondream Detect.
# Both also use FAL_ANALYSIS_TIMEOUT; failures continue from source photographs.
# Legacy models remain selectable for comparison:
# FAL_ANALYSIS_MODEL=fal-ai/sa2va/8b/image
# FAL_ANALYSIS_MODEL=fal-ai/sa2va/4b/image
